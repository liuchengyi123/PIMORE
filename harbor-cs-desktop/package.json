{
    "name": "harbor-cs-desktop",
    "version": "1.0.0",
    "description": "Harbor CS agent desktop console",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron .",
        "pack": "electron-builder --dir",
        "dist": "electron-builder --win nsis"
    },
    "build": {
        "appId": "com.harbor.csdesk",
        "productName": "Harbor CS",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": [
                "nsis"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "files": [
            "main.js",
            "preload.js",
            "renderer/**/*",
            "assets/**/*",
            "package.json"
        ]
    },
    "author": "Harbor",
    "license": "UNLICENSED",
    "devDependencies": {
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8"
    },
    "dependencies": {
        "ws": "^8.22.1"
    }
}
